!tacotac-app/public/assets/persona-*.jpg
# Exception : le pipeline vidéo a 136 memes en .jpg — sans ça ils seraient
# silencieusement exclus et les rendus casseraient sur l'autre machine.
!tacotac-video-pipeline/**/*.jpg

# Logs
*.log

