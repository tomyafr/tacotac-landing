# ══════════════════════════════════════════════════════════════
#  TACOTAC — variables d'environnement
#  Copie ce fichier en ".env" (sans .example) et remplis les vraies valeurs.
#  Le .env n'est JAMAIS commité (voir .gitignore). N'y mets que des vraies clés.
# ══════════════════════════════════════════════════════════════

# ── OpenAI (génération des répliques) ───────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Secret pour signer le cookie device_id (anti-forge) ─────────
# Mets une longue chaîne aléatoire (ex: sortie de `openssl rand -hex 32`).
COOKIE_SECRET=change-moi-par-une-longue-chaine-aleatoire

# ── Port du serveur (par défaut 3000) ───────────────────────────
PORT=3000

# ── Stripe (Phase 2 — paiement) ─────────────────────────────────
# En DEV utilise les clés "test" (sk_test_… / pk_test_…), en PROD les "live".
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_WEEKLY=price_1TpFs7HNrMOsyZiCQXBWQLhI
STRIPE_PRICE_MONTHLY=price_1TpFtNHNrMOsyZiCWjyVp58q
STRIPE_PRICE_ANNUAL=price_xxxxxxxxxxxxx

# ── Resend (emails transactionnels : cadeau -10%, liens magiques) ───────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
GIFT_FROM_EMAIL=Tacotac <hello@taco-tac.app>

# ── Cadeau email -10% : coupon Stripe appliqué au mensuel ──
STRIPE_WELCOME_COUPON=xxxxxxxx

# ── Connexion Google (optionnel : bouton caché tant que non rempli) ──
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web)
# Redirect URI à déclarer : https://TON-DOMAINE/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ── URL publique de l'app (pour les redirections Stripe) ────────
PUBLIC_URL=http://localhost:3000

# ── Codes founders (séparés par des virgules) : lien à envoyer = PUBLIC_URL/app?founder=CODE ──
FOUNDER_CODES=TACO-F1-XXXXX,TACO-F2-XXXXX

# ── TikTok Content Posting API (auto-post vidéos → n8n) ──
# App key/secret : developers.tiktok.com → Manage apps → Tacotac Auto-Post
# Redirect URI déclarée côté TikTok : PUBLIC_URL/auth/tiktok/callback
TIKTOK_CLIENT_KEY=xxxxxxxxxxxxxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret partagé avec le pipeline pour appeler /internal/tiktok-token (`openssl rand -hex 24`)
TIKTOK_INTERNAL_SECRET=change-moi-par-une-longue-chaine-aleatoire
# Identifiants Sandbox : utilisés pour tout compte dont le nom finit par "_sandbox"
# (l'app Production refuse l'OAuth tant qu'elle n'est pas auditée par TikTok).
TIKTOK_SANDBOX_CLIENT_KEY=sbxxxxxxxxxxxxxxxx
TIKTOK_SANDBOX_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SELF_ONLY obligatoire tant que l'app n'est pas auditée → PUBLIC_TO_EVERYONE après
TIKTOK_PRIVACY=SELF_ONLY

# ── Console d'admin /admin/tiktok ──
# Accès : https://TON-DOMAINE/admin/tiktok?t=<ADMIN_TOKEN> (puis cookie 12h)
ADMIN_TOKEN=change-moi-par-une-longue-chaine-aleatoire
# Dossier des vidéos rendues proposées à la publication (sortie du pipeline Remotion)
TIKTOK_VIDEO_DIR=/root/tacotac-video/out

# ── Collaborateurs / affiliés (outil : node collaborator.js) ──
# COLLAB_COMMISSION_PCT        = % des ventes reversé au collaborateur (défaut 20)
# COLLAB_AUDIENCE_DISCOUNT_PCT = -% offert à ses followers via son code (défaut 10)
COLLAB_COMMISSION_PCT=20
COLLAB_AUDIENCE_DISCOUNT_PCT=10

# ── Espace collaborateur (https://TON-DOMAINE/partner) ──
# Emails qui voient la CONSOLE ADMIN de l'espace (plusieurs = séparés par des virgules).
# Tout le reste (les collaborateurs) est déduit automatiquement de la table `collaborators`.
PARTNER_ADMIN_EMAILS=tomathieuia@gmail.com

# ── Mon dashboard revenus (https://TON-DOMAINE/admin/revenus) ──
# Même accès que /admin/tiktok : ?t=<ADMIN_TOKEN> puis cookie 12 h.
# Adresses qui reçoivent les alertes de vente/résiliation (défaut : PARTNER_ADMIN_EMAILS).
OWNER_ALERT_EMAILS=tomathieuia@gmail.com
# OWNER_ALERTS=off   → coupe les alertes à l'unité
# OWNER_DIGEST=off   → coupe le récap quotidien
OWNER_DIGEST_HOUR=9

# ── Google Analytics 4 lu côté serveur (/admin/acquisition) ──
# 1. Google Cloud Console → APIs & Services → Enable "Google Analytics Data API"
# 2. IAM → Service Accounts → créer un compte → Keys → Add key → JSON
# 3. GA4 → Admin → Property access management → ajouter l'email du compte de
#    service en rôle "Viewer"
# 4. GA4 → Admin → Property details → copier l'ID NUMÉRIQUE (pas le G-XXXXXXX)
GA4_PROPERTY_ID=123456789
GA4_CREDENTIALS_FILE=/var/www/tacotac/ga4-service-account.json
# (ou coller le JSON entier dans GA4_CREDENTIALS_JSON={"type":"service_account",...})
